uses
  Math;

function Fmt(const AValue: double; APrecision, ADigits: longint): string;
begin
  if APrecision < 0 then
    result := FloatToStr(AValue)
  else
    result := FloatToStrF(AValue, ffGeneral, APrecision, ADigits);
  if AValue >= 0.0 then
    result := '+' + result;
end;

function ComponentsToString(const AValues: array of double; const ANames: array of string;
  APrecision, ADigits: longint): string;
var
  i: longint;
begin
  result := '';
  for i := Low(AValues) to High(AValues) do
    if not Math.SameValue(AValues[i], 0.0) then
    begin
      if result <> '' then result := result + ' ';
      result := result + Fmt(AValues[i], APrecision, ADigits) + ANames[i];
    end;
  if result = '' then result := '0';
end;

function GeometricScalar(const ALeft, ARight: TMultivector): double;
begin
  result := ALeft.fms * ARight.fms
          + ALeft.fm0 * ARight.fm0
          - ALeft.fm1 * ARight.fm1
          - ALeft.fm2 * ARight.fm2
          - ALeft.fm3 * ARight.fm3
          + ALeft.fm01 * ARight.fm01
          + ALeft.fm02 * ARight.fm02
          + ALeft.fm03 * ARight.fm03
          - ALeft.fm12 * ARight.fm12
          - ALeft.fm13 * ARight.fm13
          - ALeft.fm23 * ARight.fm23
          - ALeft.fm012 * ARight.fm012
          - ALeft.fm013 * ARight.fm013
          - ALeft.fm023 * ARight.fm023
          + ALeft.fm123 * ARight.fm123
          - ALeft.fm0123 * ARight.fm0123;
end;

function ShirokovInverse(const AValue: TMultivector): TMultivector;
const
  N = 4; // 2^ceil(n/2), n = 4
var
  U: TMultivector;
  k: longint;
begin
  // U(1) = A; U(k) = A (U(k-1) - C(k-1)); C(k) = N/k <U(k)>_0
  // A^-1 = (U(N-1) - C(N-1)) / C(N)
  U := AValue;
  U.fms := U.fms - N * U.fms;
  for k := 2 to N - 1 do
  begin
    U := AValue * U;
    U.fms := U.fms - (N / k) * U.fms;
  end;
  result := U / GeometricScalar(AValue, U);
end;

