function TMultivectorHelper.Inverse: TMultivector;
begin
  case GradeMask of
    1: Exit(1.0 / fms);
    2: Exit(TVector(Self).Inverse);
    8: Exit(TTrivector(Self).Inverse);
    16: Exit(TQuadrivector(Self).Inverse);
  end;
  result := ShirokovInverse(Self);
end;

function TMultivectorHelper.GradeMask: longword;
begin
  // Bit g is set when some component of grade g is non-zero
  result := 0;
  if (fms <> 0.0) then result := result or 1;
  if (fm0 <> 0.0) or (fm1 <> 0.0) or (fm2 <> 0.0) or (fm3 <> 0.0) then result := result or 2;
  if (fm01 <> 0.0) or (fm02 <> 0.0) or (fm03 <> 0.0) or (fm12 <> 0.0) or (fm13 <> 0.0) or (fm23 <> 0.0) then result := result or 4;
  if (fm012 <> 0.0) or (fm013 <> 0.0) or (fm023 <> 0.0) or (fm123 <> 0.0) then result := result or 8;
  if (fm0123 <> 0.0) then result := result or 16;
end;

