function TVectorHelper.Wedge(const AVector: TMultivector): TMultivector;
begin
  result.fms := 0.0;
  result.fm0 := fm0 * AVector.fms;
  result.fm1 := fm1 * AVector.fms;
  result.fm2 := fm2 * AVector.fms;
  result.fm3 := fm3 * AVector.fms;
  result.fm01 := fm0 * AVector.fm1
               - fm1 * AVector.fm0;
  result.fm02 := fm0 * AVector.fm2
               - fm2 * AVector.fm0;
  result.fm03 := fm0 * AVector.fm3
               - fm3 * AVector.fm0;
  result.fm12 := fm1 * AVector.fm2
               - fm2 * AVector.fm1;
  result.fm13 := fm1 * AVector.fm3
               - fm3 * AVector.fm1;
  result.fm23 := fm2 * AVector.fm3
               - fm3 * AVector.fm2;
  result.fm012 := fm0 * AVector.fm12
                - fm1 * AVector.fm02
                + fm2 * AVector.fm01;
  result.fm013 := fm0 * AVector.fm13
                - fm1 * AVector.fm03
                + fm3 * AVector.fm01;
  result.fm023 := fm0 * AVector.fm23
