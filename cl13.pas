function TTrivectorHelper.Wedge(const AVector: TMultivector): TMultivector;
begin
  result.fms := 0.0;
  result.fm0 := 0.0;
  result.fm1 := 0.0;
  result.fm2 := 0.0;
  result.fm3 := 0.0;
  result.fm01 := 0.0;
  result.fm02 := 0.0;
  result.fm03 := 0.0;
  result.fm12 := 0.0;
  result.fm13 := 0.0;
  result.fm23 := 0.0;
  result.fm012 := fm012 * AVector.fms;
  result.fm013 := fm013 * AVector.fms;
  result.fm023 := fm023 * AVector.fms;
  result.fm123 := fm123 * AVector.fms;
  result.fm0123 := fm012 * AVector.fm3
                 - fm013 * AVector.fm2
                 + fm023 * AVector.fm1
                 - fm123 * AVector.fm0;
end;

