class operator TMultivector.=(const ALeft: TMultivector; const ARight: double): boolean;
begin
  result := (ALeft.fms = ARight) and
            (ALeft.fm0 = 0.0) and
            (ALeft.fm1 = 0.0) and
            (ALeft.fm2 = 0.0) and
            (ALeft.fm3 = 0.0) and
            (ALeft.fm01 = 0.0) and
            (ALeft.fm02 = 0.0) and
            (ALeft.fm03 = 0.0) and
            (ALeft.fm12 = 0.0) and
            (ALeft.fm13 = 0.0) and
            (ALeft.fm23 = 0.0) and
            (ALeft.fm012 = 0.0) and
            (ALeft.fm013 = 0.0) and
            (ALeft.fm023 = 0.0) and
            (ALeft.fm123 = 0.0) and
            (ALeft.fm0123 = 0.0);
end;

class operator TMultivector.=(const ALeft: double; const ARight: TMultivector): boolean;
begin
  result := (ALeft = ARight.fms) and
            (0.0 = ARight.fm0) and
            (0.0 = ARight.fm1) and
            (0.0 = ARight.fm2) and
            (0.0 = ARight.fm3) and
            (0.0 = ARight.fm01) and
            (0.0 = ARight.fm02) and
            (0.0 = ARight.fm03) and
            (0.0 = ARight.fm12) and
