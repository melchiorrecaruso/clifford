function TMultivectorHelper.Wedge(const AVector: TMultivector): TMultivector;
begin
  result.fm0 := fm0 * AVector.fm0;
  result.fm1 := fm0 * AVector.fm1
              + fm1 * AVector.fm0;
  result.fm2 := fm0 * AVector.fm2
              + fm2 * AVector.fm0;
  result.fm3 := fm0 * AVector.fm3
              + fm3 * AVector.fm0;
  result.fm12 := fm0 * AVector.fm12
               + fm1 * AVector.fm2
               - fm2 * AVector.fm1
               + fm12 * AVector.fm0;
  result.fm13 := fm0 * AVector.fm13
               + fm1 * AVector.fm3
               - fm3 * AVector.fm1
               + fm13 * AVector.fm0;
  result.fm23 := fm0 * AVector.fm23
               + fm2 * AVector.fm3
               - fm3 * AVector.fm2
               + fm23 * AVector.fm0;
  result.fm123 := fm0 * AVector.fm123
                + fm1 * AVector.fm23
                - fm2 * AVector.fm13
                + fm3 * AVector.fm12
                + fm12 * AVector.fm3
                - fm13 * AVector.fm2
                + fm23 * AVector.fm1
                + fm123 * AVector.fm0;
end;

