  result.fm123 := -fm123;
end;

function TMultivectorHelper.Conjugate: TMultivector;
begin
  result.fm0 := fm0;
  result.fm1 := -fm1;
  result.fm2 := -fm2;
  result.fm3 := -fm3;
  result.fm12 := -fm12;
  result.fm13 := -fm13;
  result.fm23 := -fm23;
  result.fm123 := fm123;
end;

function TMultivectorHelper.Inverse: TMultivector;
begin
  case GradeMask of
    1: Exit(1.0 / fm0);
    2: Exit(TVector(Self).Inverse);
    4: Exit(TBivector(Self).Inverse);
    8: Exit(TTrivector(Self).Inverse);
  end;
  result := ShirokovInverse(Self);
end;

function TMultivectorHelper.GradeMask: longword;
begin
  // Bit g is set when some component of grade g is non-zero
  result := 0;
  if (fm0 <> 0.0) then result := result or 1;
  if (fm1 <> 0.0) or (fm2 <> 0.0) or (fm3 <> 0.0) then result := result or 2;
  if (fm12 <> 0.0) or (fm13 <> 0.0) or (fm23 <> 0.0) then result := result or 4;
  if (fm123 <> 0.0) then result := result or 8;
end;

