begin
  result := SameValue(NullMultivector);
end;

function TMultivectorHelper.IsScalar: boolean;
begin
  result := (not Math.SameValue(fm0, 0.0)) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm3, 0.0) and
            Math.SameValue(fm12, 0.0) and
            Math.SameValue(fm13, 0.0) and
            Math.SameValue(fm23, 0.0) and
            Math.SameValue(fm123, 0.0);
end;

function TMultivectorHelper.IsVector: boolean;
begin
  result := (not Math.SameValue(fm1, 0.0) or not Math.SameValue(fm2, 0.0) or not Math.SameValue(fm3, 0.0)) and
            Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm12, 0.0) and
            Math.SameValue(fm13, 0.0) and
            Math.SameValue(fm23, 0.0) and
            Math.SameValue(fm123, 0.0);
end;

function TMultivectorHelper.IsBivector: boolean;
begin
  result := (not Math.SameValue(fm12, 0.0) or not Math.SameValue(fm13, 0.0) or not Math.SameValue(fm23, 0.0)) and
            Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm3, 0.0) and
            Math.SameValue(fm123, 0.0);
end;

function TMultivectorHelper.IsTrivector: boolean;
begin
  result := (not Math.SameValue(fm123, 0.0)) and
            Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm3, 0.0) and
            Math.SameValue(fm12, 0.0) and
            Math.SameValue(fm13, 0.0) and
            Math.SameValue(fm23, 0.0);
end;

function TMultivectorHelper.IsA: string;
begin
  if IsNull then Exit('Null');
  if IsTrivector then Exit('TTrivector');
  if IsBivector then Exit('TBivector');
  if IsVector then Exit('TVector');
  if IsScalar then Exit('TScalar');
  result := 'TMultivector';
end;

function TMultivectorHelper.Norm: double;
begin
  result := Sqrt(Abs(SquaredNorm));
end;

function TMultivectorHelper.SquaredNorm: double;
begin
  result := fm0 * fm0
          + fm1 * fm1
          + fm2 * fm2
          + fm3 * fm3
          + fm12 * fm12
          + fm13 * fm13
          + fm23 * fm23
          + fm123 * fm123;
end;

function TMultivectorHelper.Dual: TMultivector;
begin
  result.fm0 := -fm123;
  result.fm1 := -fm23;
  result.fm2 := fm13;
  result.fm3 := -fm12;
  result.fm12 := fm3;
  result.fm13 := -fm2;
  result.fm23 := fm1;
  result.fm123 := fm0;
end;

