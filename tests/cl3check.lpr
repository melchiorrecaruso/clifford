program cl3check;

{ Self-check of the generated unit cl3: algebraic laws, and consistency
  between the k-vector types and TMultivector.
  Generated by the Clifford toolkit (clgencore.pas): do not edit by hand. }

{$mode objfpc}{$H+}

uses
  SysUtils, Math, cl3;

var
  Checks: longint = 0;
  Failures: longint = 0;
  Skipped: longint = 0;

procedure Check(ACondition: boolean; const AName: string);
begin
  Inc(Checks);
  if ACondition then Exit;
  Inc(Failures);
  if Failures <= 20 then Writeln('FAILED: ', AName);
end;

function Rnd: double;
begin
  // Small integers keep sums of products exact in double precision
  result := RandomRange(-9, 10);
end;

function ToMV(const AValue: TMultivector): TMultivector;
begin
  result := AValue;
end;

function Same(const A, B: TMultivector): boolean;
begin
  result := A = B;
end;

function Near(const A, B: TMultivector; ATolerance: double = 1e-7): boolean;
var
  C: TMultivectorComponent;
  Scale: double;
begin
  Scale := 1.0;
  for C := Low(TMultivectorComponent) to High(TMultivectorComponent) do
    Scale := Max(Scale, Max(Abs(A.Components[C]), Abs(B.Components[C])));
  for C := Low(TMultivectorComponent) to High(TMultivectorComponent) do
    if Abs(A.Components[C] - B.Components[C]) > ATolerance * Scale then Exit(False);
  result := True;
end;

function RandomVector: TVector;
var
  C: TVectorComponent;
begin
  result := NullVector;
  for C := Low(TVectorComponent) to High(TVectorComponent) do
    result.Components[C] := Rnd;
end;

function RandomBivector: TBivector;
var
  C: TBivectorComponent;
begin
  result := NullBivector;
  for C := Low(TBivectorComponent) to High(TBivectorComponent) do
    result.Components[C] := Rnd;
end;

function RandomTrivector: TTrivector;
var
  C: TTrivectorComponent;
begin
  result := NullTrivector;
  for C := Low(TTrivectorComponent) to High(TTrivectorComponent) do
    result.Components[C] := Rnd;
end;

function RandomMultivector: TMultivector;
var
  C: TMultivectorComponent;
begin
  result := NullMultivector;
  for C := Low(TMultivectorComponent) to High(TMultivectorComponent) do
    result.Components[C] := Rnd;
end;

procedure CheckBasis;
begin
  Check(Same(u1 * u1, 1), 'e1^2 = 1');
  Check(Same(u2 * u2, 1), 'e2^2 = 1');
  Check(Same(u3 * u3, 1), 'e3^2 = 1');
  Check(Same(u1 * u2, -(u2 * u1)), 'e1 e2 = -e2 e1');
  Check(Same(u1 * u3, -(u3 * u1)), 'e1 e3 = -e3 e1');
  Check(Same(u2 * u3, -(u3 * u2)), 'e2 e3 = -e3 e2');
  Check(Same(ToMV(u1) * u2, u12), 'e12 as a product of vectors');
  Check(Same(ToMV(u1) * u3, u13), 'e13 as a product of vectors');
  Check(Same(ToMV(u2) * u3, u23), 'e23 as a product of vectors');
  Check(Same(ToMV(u1) * u2 * u3, u123), 'e123 as a product of vectors');
  Check(Same(u1.Cross(u2), 1 * u3), 'cross product of the first two basis vectors');
end;

procedure CheckRandom;
var
  X1, Y1, Z1: TVector;
  X2, Y2, Z2: TBivector;
  X3, Y3, Z3: TTrivector;
  X4, Y4, Z4: TMultivector;
begin
  X1 := RandomVector; Y1 := RandomVector; Z1 := RandomVector;
  X2 := RandomBivector; Y2 := RandomBivector; Z2 := RandomBivector;
  X3 := RandomTrivector; Y3 := RandomTrivector; Z3 := RandomTrivector;
  X4 := RandomMultivector; Y4 := RandomMultivector; Z4 := RandomMultivector;

  Check(Same((X4 * Y4) * Z4, X4 * (Y4 * Z4)), 'associativity');
  Check(Same((X4 * Y4).Reverse, Y4.Reverse * X4.Reverse), 'reverse of a product');
  Check(Same((X4 * Y4).Involute, X4.Involute * Y4.Involute), 'involution of a product');
  Check(Same(X4.Conjugate, X4.Reverse.Involute), 'conjugate = reverse of involution');
  Check(X4.SquaredNorm = (X4 * X4.Reverse).ExtractScalar, 'squared norm');
  Check(Same(X4.Dual, X4 * u123), 'dual');
  Check(Same(X1.Wedge(Y1), (X1 * Y1 - Y1 * X1) / 2), 'wedge of vectors');
  Check(Same(X1.Dot(Y1), (X1 * Y1 + Y1 * X1) / 2), 'dot of vectors');
  try Check(Near(X4 * X4.Inverse, 1), 'right inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Inverse * X4, 1), 'left inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Projection(Y1) + X1.Rejection(Y1), X1), 'projection + rejection'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotation(Y1, Z1).SquaredNorm, X1.SquaredNorm), 'rotation preserves the norm'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotate(Z1 * Y1), X1.Rotation(Y1, Z1) * (Y1.SquaredNorm * Z1.SquaredNorm)), 'rotate = rotation'); except on EMathError do Inc(Skipped); end;

  // TVector
  try Check(Near(X1 * X1.Inverse, 1), 'TVector inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Same(X1.Inverse, ToMV(X1).Inverse), 'TVector inverse type'); except on EMathError do Inc(Skipped); end;
  Check(Same(X1.Dual, ToMV(X1).Dual), 'TVector dual');
  Check(Same(X1.Reverse, ToMV(X1).Reverse), 'TVector reverse');
  Check(Same(X1.Conjugate, ToMV(X1).Conjugate), 'TVector conjugate');
  Check(Same(X1.Involute, ToMV(X1).Involute), 'TVector involution');
  Check(X1.SquaredNorm = ToMV(X1).SquaredNorm, 'TVector squared norm');
  Check(Same(-X1, -ToMV(X1)), 'TVector negation');
  Check(Same(2.5 * X1, 2.5 * ToMV(X1)), 'TVector scaling');
  Check(Same(X1 * Y1, ToMV(X1) * ToMV(Y1)), 'TVector * TVector');
  Check(Same(X1 + Y1, ToMV(X1) + ToMV(Y1)), 'TVector + TVector');
  Check(Same(X1 - Y1, ToMV(X1) - ToMV(Y1)), 'TVector - TVector');
  Check(Same(X1.Dot(Y1), ToMV(X1).Dot(ToMV(Y1))), 'TVector dot TVector');
  Check(Same(X1.Wedge(Y1), ToMV(X1).Wedge(ToMV(Y1))), 'TVector wedge TVector');
  try Check(Near(X1 / Y1, ToMV(X1) / ToMV(Y1)), 'TVector / TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Projection(Y1), ToMV(X1).Projection(ToMV(Y1))), 'TVector projection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rejection(Y1), ToMV(X1).Rejection(ToMV(Y1))), 'TVector rejection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Reflection(Y1), ToMV(X1).Reflection(ToMV(Y1))), 'TVector reflection by TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotation(Y1, Z1), ToMV(X1).Rotation(ToMV(Y1), ToMV(Z1))), 'TVector rotation by TVector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X1 * Y2, ToMV(X1) * ToMV(Y2)), 'TVector * TBivector');
  Check(Same(X1 + Y2, ToMV(X1) + ToMV(Y2)), 'TVector + TBivector');
  Check(Same(X1 - Y2, ToMV(X1) - ToMV(Y2)), 'TVector - TBivector');
  Check(Same(X1.Dot(Y2), ToMV(X1).Dot(ToMV(Y2))), 'TVector dot TBivector');
  Check(Same(X1.Wedge(Y2), ToMV(X1).Wedge(ToMV(Y2))), 'TVector wedge TBivector');
  try Check(Near(X1 / Y2, ToMV(X1) / ToMV(Y2)), 'TVector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Projection(Y2), ToMV(X1).Projection(ToMV(Y2))), 'TVector projection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rejection(Y2), ToMV(X1).Rejection(ToMV(Y2))), 'TVector rejection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Reflection(Y2), ToMV(X1).Reflection(ToMV(Y2))), 'TVector reflection by TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotation(Y2, Z2), ToMV(X1).Rotation(ToMV(Y2), ToMV(Z2))), 'TVector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X1 * Y3, ToMV(X1) * ToMV(Y3)), 'TVector * TTrivector');
  Check(Same(X1 + Y3, ToMV(X1) + ToMV(Y3)), 'TVector + TTrivector');
  Check(Same(X1 - Y3, ToMV(X1) - ToMV(Y3)), 'TVector - TTrivector');
  Check(Same(X1.Dot(Y3), ToMV(X1).Dot(ToMV(Y3))), 'TVector dot TTrivector');
  Check(Same(X1.Wedge(Y3), ToMV(X1).Wedge(ToMV(Y3))), 'TVector wedge TTrivector');
  try Check(Near(X1 / Y3, ToMV(X1) / ToMV(Y3)), 'TVector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Projection(Y3), ToMV(X1).Projection(ToMV(Y3))), 'TVector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rejection(Y3), ToMV(X1).Rejection(ToMV(Y3))), 'TVector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Reflection(Y3), ToMV(X1).Reflection(ToMV(Y3))), 'TVector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotation(Y3, Z3), ToMV(X1).Rotation(ToMV(Y3), ToMV(Z3))), 'TVector rotation by TTrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X1 * Y4, ToMV(X1) * ToMV(Y4)), 'TVector * TMultivector');
  Check(Same(X1 + Y4, ToMV(X1) + ToMV(Y4)), 'TVector + TMultivector');
  Check(Same(X1 - Y4, ToMV(X1) - ToMV(Y4)), 'TVector - TMultivector');
  Check(Same(X1.Dot(Y4), ToMV(X1).Dot(ToMV(Y4))), 'TVector dot TMultivector');
  Check(Same(X1.Wedge(Y4), ToMV(X1).Wedge(ToMV(Y4))), 'TVector wedge TMultivector');
  try Check(Near(X1 / Y4, ToMV(X1) / ToMV(Y4)), 'TVector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Projection(Y4), ToMV(X1).Projection(ToMV(Y4))), 'TVector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rejection(Y4), ToMV(X1).Rejection(ToMV(Y4))), 'TVector rejection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Reflection(Y4), ToMV(X1).Reflection(ToMV(Y4))), 'TVector reflection by TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X1.Rotation(Y4, Z4), ToMV(X1).Rotation(ToMV(Y4), ToMV(Z4))), 'TVector rotation by TMultivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X1.Rotate(Y1 * Z1), ToMV(X1).Rotate(Y1 * Z1)), 'TVector rotate');
  // TBivector
  try Check(Near(X2 * X2.Inverse, 1), 'TBivector inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Same(X2.Inverse, ToMV(X2).Inverse), 'TBivector inverse type'); except on EMathError do Inc(Skipped); end;
  Check(Same(X2.Dual, ToMV(X2).Dual), 'TBivector dual');
  Check(Same(X2.Reverse, ToMV(X2).Reverse), 'TBivector reverse');
  Check(Same(X2.Conjugate, ToMV(X2).Conjugate), 'TBivector conjugate');
  Check(Same(X2.Involute, ToMV(X2).Involute), 'TBivector involution');
  Check(X2.SquaredNorm = ToMV(X2).SquaredNorm, 'TBivector squared norm');
  Check(Same(-X2, -ToMV(X2)), 'TBivector negation');
  Check(Same(2.5 * X2, 2.5 * ToMV(X2)), 'TBivector scaling');
  Check(Same(X2 * Y1, ToMV(X2) * ToMV(Y1)), 'TBivector * TVector');
  Check(Same(X2 + Y1, ToMV(X2) + ToMV(Y1)), 'TBivector + TVector');
  Check(Same(X2 - Y1, ToMV(X2) - ToMV(Y1)), 'TBivector - TVector');
  Check(Same(X2.Dot(Y1), ToMV(X2).Dot(ToMV(Y1))), 'TBivector dot TVector');
  Check(Same(X2.Wedge(Y1), ToMV(X2).Wedge(ToMV(Y1))), 'TBivector wedge TVector');
  try Check(Near(X2 / Y1, ToMV(X2) / ToMV(Y1)), 'TBivector / TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Projection(Y1), ToMV(X2).Projection(ToMV(Y1))), 'TBivector projection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rejection(Y1), ToMV(X2).Rejection(ToMV(Y1))), 'TBivector rejection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Reflection(Y1), ToMV(X2).Reflection(ToMV(Y1))), 'TBivector reflection by TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rotation(Y1, Z1), ToMV(X2).Rotation(ToMV(Y1), ToMV(Z1))), 'TBivector rotation by TVector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X2 * Y2, ToMV(X2) * ToMV(Y2)), 'TBivector * TBivector');
  Check(Same(X2 + Y2, ToMV(X2) + ToMV(Y2)), 'TBivector + TBivector');
  Check(Same(X2 - Y2, ToMV(X2) - ToMV(Y2)), 'TBivector - TBivector');
  Check(Same(X2.Dot(Y2), ToMV(X2).Dot(ToMV(Y2))), 'TBivector dot TBivector');
  Check(Same(X2.Wedge(Y2), ToMV(X2).Wedge(ToMV(Y2))), 'TBivector wedge TBivector');
  try Check(Near(X2 / Y2, ToMV(X2) / ToMV(Y2)), 'TBivector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Projection(Y2), ToMV(X2).Projection(ToMV(Y2))), 'TBivector projection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rejection(Y2), ToMV(X2).Rejection(ToMV(Y2))), 'TBivector rejection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Reflection(Y2), ToMV(X2).Reflection(ToMV(Y2))), 'TBivector reflection by TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rotation(Y2, Z2), ToMV(X2).Rotation(ToMV(Y2), ToMV(Z2))), 'TBivector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X2 * Y3, ToMV(X2) * ToMV(Y3)), 'TBivector * TTrivector');
  Check(Same(X2 + Y3, ToMV(X2) + ToMV(Y3)), 'TBivector + TTrivector');
  Check(Same(X2 - Y3, ToMV(X2) - ToMV(Y3)), 'TBivector - TTrivector');
  Check(Same(X2.Dot(Y3), ToMV(X2).Dot(ToMV(Y3))), 'TBivector dot TTrivector');
  Check(Same(X2.Wedge(Y3), ToMV(X2).Wedge(ToMV(Y3))), 'TBivector wedge TTrivector');
  try Check(Near(X2 / Y3, ToMV(X2) / ToMV(Y3)), 'TBivector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Projection(Y3), ToMV(X2).Projection(ToMV(Y3))), 'TBivector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rejection(Y3), ToMV(X2).Rejection(ToMV(Y3))), 'TBivector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Reflection(Y3), ToMV(X2).Reflection(ToMV(Y3))), 'TBivector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rotation(Y3, Z3), ToMV(X2).Rotation(ToMV(Y3), ToMV(Z3))), 'TBivector rotation by TTrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X2 * Y4, ToMV(X2) * ToMV(Y4)), 'TBivector * TMultivector');
  Check(Same(X2 + Y4, ToMV(X2) + ToMV(Y4)), 'TBivector + TMultivector');
  Check(Same(X2 - Y4, ToMV(X2) - ToMV(Y4)), 'TBivector - TMultivector');
  Check(Same(X2.Dot(Y4), ToMV(X2).Dot(ToMV(Y4))), 'TBivector dot TMultivector');
  Check(Same(X2.Wedge(Y4), ToMV(X2).Wedge(ToMV(Y4))), 'TBivector wedge TMultivector');
  try Check(Near(X2 / Y4, ToMV(X2) / ToMV(Y4)), 'TBivector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Projection(Y4), ToMV(X2).Projection(ToMV(Y4))), 'TBivector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rejection(Y4), ToMV(X2).Rejection(ToMV(Y4))), 'TBivector rejection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Reflection(Y4), ToMV(X2).Reflection(ToMV(Y4))), 'TBivector reflection by TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X2.Rotation(Y4, Z4), ToMV(X2).Rotation(ToMV(Y4), ToMV(Z4))), 'TBivector rotation by TMultivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X2.Rotate(Y1 * Z1), ToMV(X2).Rotate(Y1 * Z1)), 'TBivector rotate');
  // TTrivector
  try Check(Near(X3 * X3.Inverse, 1), 'TTrivector inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Same(X3.Inverse, ToMV(X3).Inverse), 'TTrivector inverse type'); except on EMathError do Inc(Skipped); end;
  Check(Same(X3.Dual, ToMV(X3).Dual), 'TTrivector dual');
  Check(Same(X3.Reverse, ToMV(X3).Reverse), 'TTrivector reverse');
  Check(Same(X3.Conjugate, ToMV(X3).Conjugate), 'TTrivector conjugate');
  Check(Same(X3.Involute, ToMV(X3).Involute), 'TTrivector involution');
  Check(X3.SquaredNorm = ToMV(X3).SquaredNorm, 'TTrivector squared norm');
  Check(Same(-X3, -ToMV(X3)), 'TTrivector negation');
  Check(Same(2.5 * X3, 2.5 * ToMV(X3)), 'TTrivector scaling');
  Check(Same(X3 * Y1, ToMV(X3) * ToMV(Y1)), 'TTrivector * TVector');
  Check(Same(X3 + Y1, ToMV(X3) + ToMV(Y1)), 'TTrivector + TVector');
  Check(Same(X3 - Y1, ToMV(X3) - ToMV(Y1)), 'TTrivector - TVector');
  Check(Same(X3.Dot(Y1), ToMV(X3).Dot(ToMV(Y1))), 'TTrivector dot TVector');
  Check(Same(X3.Wedge(Y1), ToMV(X3).Wedge(ToMV(Y1))), 'TTrivector wedge TVector');
  try Check(Near(X3 / Y1, ToMV(X3) / ToMV(Y1)), 'TTrivector / TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Projection(Y1), ToMV(X3).Projection(ToMV(Y1))), 'TTrivector projection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rejection(Y1), ToMV(X3).Rejection(ToMV(Y1))), 'TTrivector rejection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Reflection(Y1), ToMV(X3).Reflection(ToMV(Y1))), 'TTrivector reflection by TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rotation(Y1, Z1), ToMV(X3).Rotation(ToMV(Y1), ToMV(Z1))), 'TTrivector rotation by TVector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X3 * Y2, ToMV(X3) * ToMV(Y2)), 'TTrivector * TBivector');
  Check(Same(X3 + Y2, ToMV(X3) + ToMV(Y2)), 'TTrivector + TBivector');
  Check(Same(X3 - Y2, ToMV(X3) - ToMV(Y2)), 'TTrivector - TBivector');
  Check(Same(X3.Dot(Y2), ToMV(X3).Dot(ToMV(Y2))), 'TTrivector dot TBivector');
  Check(Same(X3.Wedge(Y2), ToMV(X3).Wedge(ToMV(Y2))), 'TTrivector wedge TBivector');
  try Check(Near(X3 / Y2, ToMV(X3) / ToMV(Y2)), 'TTrivector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Projection(Y2), ToMV(X3).Projection(ToMV(Y2))), 'TTrivector projection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rejection(Y2), ToMV(X3).Rejection(ToMV(Y2))), 'TTrivector rejection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Reflection(Y2), ToMV(X3).Reflection(ToMV(Y2))), 'TTrivector reflection by TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rotation(Y2, Z2), ToMV(X3).Rotation(ToMV(Y2), ToMV(Z2))), 'TTrivector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X3 * Y3, ToMV(X3) * ToMV(Y3)), 'TTrivector * TTrivector');
  Check(Same(X3 + Y3, ToMV(X3) + ToMV(Y3)), 'TTrivector + TTrivector');
  Check(Same(X3 - Y3, ToMV(X3) - ToMV(Y3)), 'TTrivector - TTrivector');
  Check(Same(X3.Dot(Y3), ToMV(X3).Dot(ToMV(Y3))), 'TTrivector dot TTrivector');
  Check(Same(X3.Wedge(Y3), ToMV(X3).Wedge(ToMV(Y3))), 'TTrivector wedge TTrivector');
  try Check(Near(X3 / Y3, ToMV(X3) / ToMV(Y3)), 'TTrivector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Projection(Y3), ToMV(X3).Projection(ToMV(Y3))), 'TTrivector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rejection(Y3), ToMV(X3).Rejection(ToMV(Y3))), 'TTrivector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Reflection(Y3), ToMV(X3).Reflection(ToMV(Y3))), 'TTrivector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rotation(Y3, Z3), ToMV(X3).Rotation(ToMV(Y3), ToMV(Z3))), 'TTrivector rotation by TTrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X3 * Y4, ToMV(X3) * ToMV(Y4)), 'TTrivector * TMultivector');
  Check(Same(X3 + Y4, ToMV(X3) + ToMV(Y4)), 'TTrivector + TMultivector');
  Check(Same(X3 - Y4, ToMV(X3) - ToMV(Y4)), 'TTrivector - TMultivector');
  Check(Same(X3.Dot(Y4), ToMV(X3).Dot(ToMV(Y4))), 'TTrivector dot TMultivector');
  Check(Same(X3.Wedge(Y4), ToMV(X3).Wedge(ToMV(Y4))), 'TTrivector wedge TMultivector');
  try Check(Near(X3 / Y4, ToMV(X3) / ToMV(Y4)), 'TTrivector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Projection(Y4), ToMV(X3).Projection(ToMV(Y4))), 'TTrivector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rejection(Y4), ToMV(X3).Rejection(ToMV(Y4))), 'TTrivector rejection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Reflection(Y4), ToMV(X3).Reflection(ToMV(Y4))), 'TTrivector reflection by TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Rotation(Y4, Z4), ToMV(X3).Rotation(ToMV(Y4), ToMV(Z4))), 'TTrivector rotation by TMultivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X3.Rotate(Y1 * Z1), ToMV(X3).Rotate(Y1 * Z1)), 'TTrivector rotate');
  // TMultivector
  try Check(Near(X4 * X4.Inverse, 1), 'TMultivector inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Same(X4.Inverse, ToMV(X4).Inverse), 'TMultivector inverse type'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4.Dual, ToMV(X4).Dual), 'TMultivector dual');
  Check(Same(X4.Reverse, ToMV(X4).Reverse), 'TMultivector reverse');
  Check(Same(X4.Conjugate, ToMV(X4).Conjugate), 'TMultivector conjugate');
  Check(Same(X4.Involute, ToMV(X4).Involute), 'TMultivector involution');
  Check(X4.SquaredNorm = ToMV(X4).SquaredNorm, 'TMultivector squared norm');
  Check(Same(-X4, -ToMV(X4)), 'TMultivector negation');
  Check(Same(2.5 * X4, 2.5 * ToMV(X4)), 'TMultivector scaling');
  Check(Same(X4 * Y1, ToMV(X4) * ToMV(Y1)), 'TMultivector * TVector');
  Check(Same(X4 + Y1, ToMV(X4) + ToMV(Y1)), 'TMultivector + TVector');
  Check(Same(X4 - Y1, ToMV(X4) - ToMV(Y1)), 'TMultivector - TVector');
  Check(Same(X4.Dot(Y1), ToMV(X4).Dot(ToMV(Y1))), 'TMultivector dot TVector');
  Check(Same(X4.Wedge(Y1), ToMV(X4).Wedge(ToMV(Y1))), 'TMultivector wedge TVector');
  try Check(Near(X4 / Y1, ToMV(X4) / ToMV(Y1)), 'TMultivector / TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y1), ToMV(X4).Projection(ToMV(Y1))), 'TMultivector projection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y1), ToMV(X4).Rejection(ToMV(Y1))), 'TMultivector rejection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y1), ToMV(X4).Reflection(ToMV(Y1))), 'TMultivector reflection by TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y1, Z1), ToMV(X4).Rotation(ToMV(Y1), ToMV(Z1))), 'TMultivector rotation by TVector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4 * Y2, ToMV(X4) * ToMV(Y2)), 'TMultivector * TBivector');
  Check(Same(X4 + Y2, ToMV(X4) + ToMV(Y2)), 'TMultivector + TBivector');
  Check(Same(X4 - Y2, ToMV(X4) - ToMV(Y2)), 'TMultivector - TBivector');
  Check(Same(X4.Dot(Y2), ToMV(X4).Dot(ToMV(Y2))), 'TMultivector dot TBivector');
  Check(Same(X4.Wedge(Y2), ToMV(X4).Wedge(ToMV(Y2))), 'TMultivector wedge TBivector');
  try Check(Near(X4 / Y2, ToMV(X4) / ToMV(Y2)), 'TMultivector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y2), ToMV(X4).Projection(ToMV(Y2))), 'TMultivector projection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y2), ToMV(X4).Rejection(ToMV(Y2))), 'TMultivector rejection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y2), ToMV(X4).Reflection(ToMV(Y2))), 'TMultivector reflection by TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y2, Z2), ToMV(X4).Rotation(ToMV(Y2), ToMV(Z2))), 'TMultivector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4 * Y3, ToMV(X4) * ToMV(Y3)), 'TMultivector * TTrivector');
  Check(Same(X4 + Y3, ToMV(X4) + ToMV(Y3)), 'TMultivector + TTrivector');
  Check(Same(X4 - Y3, ToMV(X4) - ToMV(Y3)), 'TMultivector - TTrivector');
  Check(Same(X4.Dot(Y3), ToMV(X4).Dot(ToMV(Y3))), 'TMultivector dot TTrivector');
  Check(Same(X4.Wedge(Y3), ToMV(X4).Wedge(ToMV(Y3))), 'TMultivector wedge TTrivector');
  try Check(Near(X4 / Y3, ToMV(X4) / ToMV(Y3)), 'TMultivector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y3), ToMV(X4).Projection(ToMV(Y3))), 'TMultivector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y3), ToMV(X4).Rejection(ToMV(Y3))), 'TMultivector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y3), ToMV(X4).Reflection(ToMV(Y3))), 'TMultivector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y3, Z3), ToMV(X4).Rotation(ToMV(Y3), ToMV(Z3))), 'TMultivector rotation by TTrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4 * Y4, ToMV(X4) * ToMV(Y4)), 'TMultivector * TMultivector');
  Check(Same(X4 + Y4, ToMV(X4) + ToMV(Y4)), 'TMultivector + TMultivector');
  Check(Same(X4 - Y4, ToMV(X4) - ToMV(Y4)), 'TMultivector - TMultivector');
  Check(Same(X4.Dot(Y4), ToMV(X4).Dot(ToMV(Y4))), 'TMultivector dot TMultivector');
  Check(Same(X4.Wedge(Y4), ToMV(X4).Wedge(ToMV(Y4))), 'TMultivector wedge TMultivector');
  try Check(Near(X4 / Y4, ToMV(X4) / ToMV(Y4)), 'TMultivector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y4), ToMV(X4).Projection(ToMV(Y4))), 'TMultivector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y4), ToMV(X4).Rejection(ToMV(Y4))), 'TMultivector rejection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y4), ToMV(X4).Reflection(ToMV(Y4))), 'TMultivector reflection by TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y4, Z4), ToMV(X4).Rotation(ToMV(Y4), ToMV(Z4))), 'TMultivector rotation by TMultivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4.Rotate(Y1 * Z1), ToMV(X4).Rotate(Y1 * Z1)), 'TMultivector rotate');
end;

var
  Iteration: longint;
begin
  RandSeed := 1;
  CheckBasis;
  for Iteration := 1 to 12500 do
    CheckRandom;
  Writeln(Format('cl3: %d checks, %d failures, %d skipped (singular operands)', [Checks, Failures, Skipped]));
  if Failures > 0 then Halt(1);
end.
