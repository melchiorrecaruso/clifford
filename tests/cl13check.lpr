  Check(Same(X4 * Y4, ToMV(X4) * ToMV(Y4)), 'TQuadrivector * TQuadrivector');
  Check(Same(X4 + Y4, ToMV(X4) + ToMV(Y4)), 'TQuadrivector + TQuadrivector');
