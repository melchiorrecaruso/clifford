  try Check(Near(X3 / Y4, ToMV(X3) / ToMV(Y4)), 'TTrivector / TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X3.Projection(Y4), ToMV(X3).Projection(ToMV(Y4))), 'TTrivector projection on TQuadrivector'); except on EMathError do Inc(Skipped); end;
