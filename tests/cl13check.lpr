  try Check(Near(X4 / Y3, ToMV(X4) / ToMV(Y3)), 'TQuadrivector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y3), ToMV(X4).Projection(ToMV(Y3))), 'TQuadrivector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y3), ToMV(X4).Rejection(ToMV(Y3))), 'TQuadrivector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y3), ToMV(X4).Reflection(ToMV(Y3))), 'TQuadrivector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
