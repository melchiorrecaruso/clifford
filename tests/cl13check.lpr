  Check(Same(X5.Conjugate, ToMV(X5).Conjugate), 'TMultivector conjugate');
  Check(Same(X5.Involute, ToMV(X5).Involute), 'TMultivector involution');
  Check(X5.SquaredNorm = ToMV(X5).SquaredNorm, 'TMultivector squared norm');
  Check(Same(-X5, -ToMV(X5)), 'TMultivector negation');
  Check(Same(2.5 * X5, 2.5 * ToMV(X5)), 'TMultivector scaling');
  Check(Same(X5 * Y1, ToMV(X5) * ToMV(Y1)), 'TMultivector * TVector');
  Check(Same(X5 + Y1, ToMV(X5) + ToMV(Y1)), 'TMultivector + TVector');
  Check(Same(X5 - Y1, ToMV(X5) - ToMV(Y1)), 'TMultivector - TVector');
  Check(Same(X5.Dot(Y1), ToMV(X5).Dot(ToMV(Y1))), 'TMultivector dot TVector');
  Check(Same(X5.Wedge(Y1), ToMV(X5).Wedge(ToMV(Y1))), 'TMultivector wedge TVector');
  try Check(Near(X5 / Y1, ToMV(X5) / ToMV(Y1)), 'TMultivector / TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Projection(Y1), ToMV(X5).Projection(ToMV(Y1))), 'TMultivector projection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rejection(Y1), ToMV(X5).Rejection(ToMV(Y1))), 'TMultivector rejection on TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Reflection(Y1), ToMV(X5).Reflection(ToMV(Y1))), 'TMultivector reflection by TVector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rotation(Y1, Z1), ToMV(X5).Rotation(ToMV(Y1), ToMV(Z1))), 'TMultivector rotation by TVector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X5 * Y2, ToMV(X5) * ToMV(Y2)), 'TMultivector * TBivector');
  Check(Same(X5 + Y2, ToMV(X5) + ToMV(Y2)), 'TMultivector + TBivector');
  Check(Same(X5 - Y2, ToMV(X5) - ToMV(Y2)), 'TMultivector - TBivector');
  Check(Same(X5.Dot(Y2), ToMV(X5).Dot(ToMV(Y2))), 'TMultivector dot TBivector');
  Check(Same(X5.Wedge(Y2), ToMV(X5).Wedge(ToMV(Y2))), 'TMultivector wedge TBivector');
  try Check(Near(X5 / Y2, ToMV(X5) / ToMV(Y2)), 'TMultivector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Projection(Y2), ToMV(X5).Projection(ToMV(Y2))), 'TMultivector projection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rejection(Y2), ToMV(X5).Rejection(ToMV(Y2))), 'TMultivector rejection on TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Reflection(Y2), ToMV(X5).Reflection(ToMV(Y2))), 'TMultivector reflection by TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rotation(Y2, Z2), ToMV(X5).Rotation(ToMV(Y2), ToMV(Z2))), 'TMultivector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X5 * Y3, ToMV(X5) * ToMV(Y3)), 'TMultivector * TTrivector');
  Check(Same(X5 + Y3, ToMV(X5) + ToMV(Y3)), 'TMultivector + TTrivector');
  Check(Same(X5 - Y3, ToMV(X5) - ToMV(Y3)), 'TMultivector - TTrivector');
  Check(Same(X5.Dot(Y3), ToMV(X5).Dot(ToMV(Y3))), 'TMultivector dot TTrivector');
  Check(Same(X5.Wedge(Y3), ToMV(X5).Wedge(ToMV(Y3))), 'TMultivector wedge TTrivector');
  try Check(Near(X5 / Y3, ToMV(X5) / ToMV(Y3)), 'TMultivector / TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Projection(Y3), ToMV(X5).Projection(ToMV(Y3))), 'TMultivector projection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rejection(Y3), ToMV(X5).Rejection(ToMV(Y3))), 'TMultivector rejection on TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Reflection(Y3), ToMV(X5).Reflection(ToMV(Y3))), 'TMultivector reflection by TTrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rotation(Y3, Z3), ToMV(X5).Rotation(ToMV(Y3), ToMV(Z3))), 'TMultivector rotation by TTrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X5 * Y4, ToMV(X5) * ToMV(Y4)), 'TMultivector * TQuadrivector');
  Check(Same(X5 + Y4, ToMV(X5) + ToMV(Y4)), 'TMultivector + TQuadrivector');
  Check(Same(X5 - Y4, ToMV(X5) - ToMV(Y4)), 'TMultivector - TQuadrivector');
  Check(Same(X5.Dot(Y4), ToMV(X5).Dot(ToMV(Y4))), 'TMultivector dot TQuadrivector');
  Check(Same(X5.Wedge(Y4), ToMV(X5).Wedge(ToMV(Y4))), 'TMultivector wedge TQuadrivector');
  try Check(Near(X5 / Y4, ToMV(X5) / ToMV(Y4)), 'TMultivector / TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Projection(Y4), ToMV(X5).Projection(ToMV(Y4))), 'TMultivector projection on TQuadrivector'); except on EMathError do Inc(Skipped); end;
