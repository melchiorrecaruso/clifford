  try Check(Near(X4.Projection(Y4), ToMV(X4).Projection(ToMV(Y4))), 'TQuadrivector projection on TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y4), ToMV(X4).Rejection(ToMV(Y4))), 'TQuadrivector rejection on TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y4), ToMV(X4).Reflection(ToMV(Y4))), 'TQuadrivector reflection by TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y4, Z4), ToMV(X4).Rotation(ToMV(Y4), ToMV(Z4))), 'TQuadrivector rotation by TQuadrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4 * Y5, ToMV(X4) * ToMV(Y5)), 'TQuadrivector * TMultivector');
  Check(Same(X4 + Y5, ToMV(X4) + ToMV(Y5)), 'TQuadrivector + TMultivector');
  Check(Same(X4 - Y5, ToMV(X4) - ToMV(Y5)), 'TQuadrivector - TMultivector');
  Check(Same(X4.Dot(Y5), ToMV(X4).Dot(ToMV(Y5))), 'TQuadrivector dot TMultivector');
  Check(Same(X4.Wedge(Y5), ToMV(X4).Wedge(ToMV(Y5))), 'TQuadrivector wedge TMultivector');
  try Check(Near(X4 / Y5, ToMV(X4) / ToMV(Y5)), 'TQuadrivector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y5), ToMV(X4).Projection(ToMV(Y5))), 'TQuadrivector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rejection(Y5), ToMV(X4).Rejection(ToMV(Y5))), 'TQuadrivector rejection on TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Reflection(Y5), ToMV(X4).Reflection(ToMV(Y5))), 'TQuadrivector reflection by TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Rotation(Y5, Z5), ToMV(X4).Rotation(ToMV(Y5), ToMV(Z5))), 'TQuadrivector rotation by TMultivector'); except on EMathError do Inc(Skipped); end;
  // TMultivector
  try Check(Near(X5 * X5.Inverse, 1), 'TMultivector inverse'); except on EMathError do Inc(Skipped); end;
  try Check(Same(X5.Inverse, ToMV(X5).Inverse), 'TMultivector inverse type'); except on EMathError do Inc(Skipped); end;
  Check(Same(X5.Dual, ToMV(X5).Dual), 'TMultivector dual');
