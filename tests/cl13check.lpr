  try Check(Near(X5.Reflection(Y4), ToMV(X5).Reflection(ToMV(Y4))), 'TMultivector reflection by TQuadrivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Rotation(Y4, Z4), ToMV(X5).Rotation(ToMV(Y4), ToMV(Z4))), 'TMultivector rotation by TQuadrivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X5 * Y5, ToMV(X5) * ToMV(Y5)), 'TMultivector * TMultivector');
  Check(Same(X5 + Y5, ToMV(X5) + ToMV(Y5)), 'TMultivector + TMultivector');
  Check(Same(X5 - Y5, ToMV(X5) - ToMV(Y5)), 'TMultivector - TMultivector');
  Check(Same(X5.Dot(Y5), ToMV(X5).Dot(ToMV(Y5))), 'TMultivector dot TMultivector');
  Check(Same(X5.Wedge(Y5), ToMV(X5).Wedge(ToMV(Y5))), 'TMultivector wedge TMultivector');
  try Check(Near(X5 / Y5, ToMV(X5) / ToMV(Y5)), 'TMultivector / TMultivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X5.Projection(Y5), ToMV(X5).Projection(ToMV(Y5))), 'TMultivector projection on TMultivector'); except on EMathError do Inc(Skipped); end;
