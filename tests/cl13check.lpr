  try Check(Near(X4 / Y2, ToMV(X4) / ToMV(Y2)), 'TQuadrivector / TBivector'); except on EMathError do Inc(Skipped); end;
  try Check(Near(X4.Projection(Y2), ToMV(X4).Projection(ToMV(Y2))), 'TQuadrivector projection on TBivector'); except on EMathError do Inc(Skipped); end;
