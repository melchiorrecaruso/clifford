  Check(Same(X4.Involute, ToMV(X4).Involute), 'TQuadrivector involution');
  Check(X4.SquaredNorm = ToMV(X4).SquaredNorm, 'TQuadrivector squared norm');
  Check(Same(-X4, -ToMV(X4)), 'TQuadrivector negation');
  Check(Same(2.5 * X4, 2.5 * ToMV(X4)), 'TQuadrivector scaling');
  Check(Same(X4 * Y1, ToMV(X4) * ToMV(Y1)), 'TQuadrivector * TVector');
  Check(Same(X4 + Y1, ToMV(X4) + ToMV(Y1)), 'TQuadrivector + TVector');
