end;

var
  Iteration: longint;
begin
  RandSeed := 1;
  CheckBasis;
  for Iteration := 1 to 6250 do
    CheckRandom;
  Writeln(Format('cl13: %d checks, %d failures, %d skipped (singular operands)', [Checks, Failures, Skipped]));
  if Failures > 0 then Halt(1);
end.
