  try Check(Near(X4.Rotation(Y2, Z2), ToMV(X4).Rotation(ToMV(Y2), ToMV(Z2))), 'TQuadrivector rotation by TBivector'); except on EMathError do Inc(Skipped); end;
  Check(Same(X4 * Y3, ToMV(X4) * ToMV(Y3)), 'TQuadrivector * TTrivector');
  Check(Same(X4 + Y3, ToMV(X4) + ToMV(Y3)), 'TQuadrivector + TTrivector');
  Check(Same(X4 - Y3, ToMV(X4) - ToMV(Y3)), 'TQuadrivector - TTrivector');
  Check(Same(X4.Dot(Y3), ToMV(X4).Dot(ToMV(Y3))), 'TQuadrivector dot TTrivector');
